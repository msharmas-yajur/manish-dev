# Tailscale Monitor Configuration
# Copy this file to .env and fill in your values

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password  # For Gmail, use App Password (not regular password)
SMTP_USE_TLS=true

# Email Settings
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=alerts@example.com,admin@example.com  # Comma-separated for multiple recipients

# Monitor Settings
STATE_FILE=./node_state.json  # Tracks node status between runs
ALERT_ON_RECOVERY=true        # Send email when nodes come back online
IGNORED_NODES=                # Comma-separated hostnames to ignore (e.g., test-node,dev-machine)
