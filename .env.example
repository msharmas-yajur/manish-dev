# ===========================================
# Healthcare Application Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# Environment
# ===========================================
NODE_ENV=development

# ===========================================
# PostgreSQL Database
# ===========================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=manish
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=manish_dev
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ===========================================
# MongoDB Database
# ===========================================
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_USER=manish
MONGO_PASSWORD=change_me_in_production
MONGO_DB=manish_dev
MONGO_URL=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@${MONGO_HOST}:${MONGO_PORT}/${MONGO_DB}?authSource=admin

# ===========================================
# Redis Cache
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# ===========================================
# LLM Providers
# ===========================================
# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Ollama (self-hosted)
OLLAMA_HOST=http://ollama:11434

# Default model for each provider
DEFAULT_OPENAI_MODEL=gpt-4-turbo-preview
DEFAULT_ANTHROPIC_MODEL=claude-3-sonnet-20240229
DEFAULT_OLLAMA_MODEL=llama3

# ===========================================
# LiveKit (Telehealth)
# ===========================================
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://livekit:7880

# ===========================================
# Snowstorm (SNOMED CT)
# ===========================================
SNOWSTORM_URL=http://snowstorm:8085

# ===========================================
# Service URLs (Internal)
# ===========================================
BFF_URL=http://bff:3001
BACKEND_URL=http://backend:8000
LLM_SERVICE_URL=http://llm-service:8003
COPILOT_URL=http://copilot:3002

# ===========================================
# Service Ports (External)
# ===========================================
FRONTEND_PORT=8081
BFF_PORT=3001
BACKEND_PORT=8000
LLM_SERVICE_PORT=8003
COPILOT_PORT=3002

# ===========================================
# Security (Change in production!)
# ===========================================
JWT_SECRET=change_this_to_a_random_secret_in_production
JWT_EXPIRATION=24h
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# ===========================================
# Celery Workers
# ===========================================
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0
